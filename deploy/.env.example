# deploy/.env: settings for docker-compose.prod.yml (setup.sh creates this file for you).
# Never commit the real .env: it holds your admin token.

# Your domain or free subdomain, pointing (A record) at the server's public IP.
# No domain yet? Use <your-ip-with-dashes>.sslip.io, e.g. 13-233-10-20.sslip.io
DOMAIN=tracebase-demo.duckdns.org

# Team mode is required on a public server. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# "Continue with Google" (optional). Google Cloud console > APIs & Services > Credentials > Create credentials >
# OAuth client ID > Web application; add https://<DOMAIN> under "Authorized JavaScript origins" (no redirect URI
# needed). Only invited emails can sign in (Team page, or `tracebase team add <name> --email ...`); the emails in
# ADMIN_EMAILS become admins on their first sign-in.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Encryption at rest for the database (code index + logs). Generate with: openssl rand -hex 32
# Keep a copy somewhere safe (a password manager): without it the database cannot be opened.
# An existing unencrypted database is encrypted automatically on the first start with a key.
DB_KEY=

# What to index and which logs to watch (folders on the server)
REPOS_DIR=/srv/tracebase/repos
LOGS_DIR=/srv/tracebase/logs

# AI explanations: "none" = built-in rules only (works on a small server).
# "ollama" needs a big server (16 GB+ RAM, or a GPU) running Ollama.
LLM_PROVIDER=none
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1

# Optional: push alerts to YOUR webhook (self-hosted ntfy, Slack incoming webhook…)
ALERT_WEBHOOK=

# Seconds between re-index runs (repos change slowly on a server; pull-repos.sh pulls them)
WATCH_INTERVAL=300

# ---- Privacy (see PRIVACY.md)
# Personal data and secrets in logs (emails, IPs, card numbers, tokens, passwords) are replaced by
# [email], [ip], [card]... before anything is stored. 0 = off.
REDACT=1
REDACT_IPS=1
# Your own patterns, as a JSON list of regular expressions, e.g. ["CUST-\\d{6}"]
REDACT_EXTRA=
# Days to keep each kind of record (0 = forever). Deleted at startup and every night.
LOG_RETENTION_DAYS=30
ERROR_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
