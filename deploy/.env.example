# deploy/.env: settings for docker-compose.prod.yml (setup.sh creates this file for you).
# Never commit the real .env: it holds your admin token.

# Your domain or free subdomain, pointing (A record) at the server's public IP.
# No domain yet? Use <your-ip-with-dashes>.sslip.io, e.g. 13-233-10-20.sslip.io
DOMAIN=tracebase-demo.duckdns.org

# Team mode is required on a public server. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# What to index and which logs to watch (folders on the server)
REPOS_DIR=/srv/tracebase/repos
LOGS_DIR=/srv/tracebase/logs

# AI explanations: "none" = built-in rules only (works on a small server).
# "ollama" needs a big server (16 GB+ RAM, or a GPU) running Ollama.
LLM_PROVIDER=none
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1

# Optional: push alerts to YOUR webhook (self-hosted ntfy, Slack incoming webhook…)
ALERT_WEBHOOK=

# Seconds between re-index runs (repos change slowly on a server; pull-repos.sh pulls them)
WATCH_INTERVAL=300
